{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage",
  "version": "0.1.3",
  "identifier": "com.juyoung.aiusage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "floatbar",
        "title": "AI Usage",
        "width": 380,
        "height": 330,
        "minWidth": 250,
        "minHeight": 110,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      },
      {
        "label": "popup",
        "title": "AI Usage",
        "width": 430,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "AI Usage — Settings",
        "width": 500,
        "height": 700,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDOEJFODdDMDk0MjJGRTQKUldUa0wwSUpmT2lML01sQkU4N2dib3RIdVZzT1FDckhXZExHbU4vS3phQzVnQ2RpclZUSXo5VTcK",
      "endpoints": [
        "https://github.com/sebaram/ai-subscription-widget/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
