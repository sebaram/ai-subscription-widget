{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage",
  "version": "0.1.0",
  "identifier": "com.juyoung.aiusage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "floatbar",
        "title": "AI Usage",
        "width": 352,
        "height": 200,
        "minWidth": 250,
        "minHeight": 110,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      },
      {
        "label": "popup",
        "title": "AI Usage",
        "width": 430,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "AI Usage — Settings",
        "width": 500,
        "height": 700,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
